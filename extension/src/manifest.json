{
  "manifest_version": 3,
  "name": "friendlypass",
  "version": "0.1.0",
  "description": "friendlypass password manager browser integration",
  "minimum_chrome_version": "124",
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill the best matching login with friendlypass"
    }
  },
  "action": {
    "default_title": "friendlypass"
  },
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "friendlypass@friendlypass.org"
    }
  }
}
