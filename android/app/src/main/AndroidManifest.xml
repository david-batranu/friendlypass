<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: the app only ever talks to content providers. -->

    <application
        android:name=".FriendlypassApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Friendlypass">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autofill: one service plus the activities its authentication/confirmation needs. -->
        <service
            android:name=".autofill.FriendlypassAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/AutofillScreen" />

        <activity
            android:name=".autofill.AutofillPickActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/AutofillDialog" />

        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/AutofillDialog" />

        <activity
            android:name=".autofill.AutofillSettingsActivity"
            android:exported="true"
            android:label="@string/autofill_settings_title"
            android:theme="@style/Theme.Friendlypass" />
        <!-- Credential Manager provider (API 34+; values-v34 enables it). -->
        <service
            android:name=".credentials.FriendlypassCredentialProviderService"
            android:enabled="@bool/credentials_provider_enabled"
            android:exported="true"
            android:label="@string/credentials_provider_label"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>

        <activity
            android:name=".credentials.CredentialsGetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Friendlypass" />

        <activity
            android:name=".credentials.CredentialsCreateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Friendlypass" />

    </application>

</manifest>
