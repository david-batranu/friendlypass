{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git -c * commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git tag*": "deny",
      "git remote*": "deny",
      "git config*": "deny",
      "git worktree*": "deny",
      "gh *": "deny",
      "sudo*": "deny",
      "pmset*": "deny",
      "opencode session*": "deny",
      "*secrets*": "deny",
      "*.pem*": "deny"
    },
    "read": { "*": "allow", "*secrets*": "deny", "*.pem": "deny" },
    "edit": { "*": "allow", "*secrets*": "deny", "*.pem": "deny" }
  }
}
